# ============================================================================
# TransformCAMT053toMT940 — reglas de exclusión
# ============================================================================
# El objetivo es versionar solo el código, los tests, las fixtures y la
# documentación. Todo lo que se genera al ejecutar el conversor (CAMT de
# entrada, MT940 de salida, logs, temporales) queda fuera del repositorio.

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-log.txt

# ----------------------------------------------------------------------------
# Entornos virtuales
# ----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------------------------------
# Tests, cobertura y cachés de herramientas
# ----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover

# ----------------------------------------------------------------------------
# Carpetas de trabajo
# ----------------------------------------------------------------------------
# Entrada/ y Salida/ son datos del usuario. Solo se versiona el marcador
# .gitkeep para que ambas carpetas existan al clonar el repositorio.
Entrada/*
!Entrada/.gitkeep
Salida/*
!Salida/.gitkeep

# Logs de cada corrida y salidas MT940 sueltas
log_*.txt
*.log
*.mt940

# ----------------------------------------------------------------------------
# Archivos temporales y artefactos locales
# ----------------------------------------------------------------------------
*.rar
*.zip
*.7z
*.tar
*.gz
*.bak
*.tmp
*.temp
~$*
*.orig
*.rej

# ----------------------------------------------------------------------------
# Sistema operativo e IDE
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
# Secretos y configuración local
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example

# ----------------------------------------------------------------------------
# Material de trabajo que no forma parte del conversor público
# ----------------------------------------------------------------------------
# Planes/notas internas y ejemplos locales con repositorios embebidos.
tasks/
Ejemplos/

# Especificaciones históricas: la vigente es SPEC.md
SPEC_V0_5.md
SPEC_v1.md
SPEC_v1_5.md
SPEC_V2.2.md
